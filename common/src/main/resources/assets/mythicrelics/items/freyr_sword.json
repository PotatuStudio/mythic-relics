{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:display_context",
  "cases": [
   {
    "when": "none",
    "model": {
     "type": "minecraft:condition",
     "property": "mythicrelics:freyr_drawn",
     "on_true": {
      "type": "minecraft:model",
      "model": "mythicrelics:item/freyr_sword_sheath_worn"
     },
     "on_false": {
      "type": "minecraft:model",
      "model": "mythicrelics:item/freyr_sword_worn"
     }
    }
   }
  ],
  "fallback": {
   "type": "minecraft:model",
   "model": "mythicrelics:item/freyr_sword"
  }
 }
}
