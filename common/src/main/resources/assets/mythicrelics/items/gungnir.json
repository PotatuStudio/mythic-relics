{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:display_context",
  "cases": [
   {
    "when": [
     "gui",
     "ground",
     "fixed",
     "on_shelf"
    ],
    "model": {
     "type": "minecraft:model",
     "model": "mythicrelics:item/gungnir"
    }
   }
  ],
  "fallback": {
   "type": "minecraft:condition",
   "property": "minecraft:using_item",
   "on_false": {
    "type": "minecraft:model",
    "model": "mythicrelics:item/gungnir_3d"
   },
   "on_true": {
    "type": "minecraft:model",
    "model": "mythicrelics:item/gungnir_throwing"
   }
  }
 }
}
